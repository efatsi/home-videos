<div class="min-h-screen px-6 py-10 max-w-6xl mx-auto">
  <h1 class="text-3xl font-bold mb-10 tracking-tight text-gray-900">Home Videos</h1>

  <% if @grouped_videos.empty? %>
    <p class="text-gray-500">No videos yet.</p>
  <% else %>
    <% @grouped_videos.each do |year, videos| %>
      <section class="mb-12">
        <h2 class="text-xl font-semibold text-gray-500 mb-4 border-b border-gray-200 pb-2"><%= year %></h2>
        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-4">
          <% videos.each do |video| %>
            <%= link_to video_path(video), class: "group block" do %>
              <div class="relative aspect-video bg-gray-200 rounded-lg overflow-hidden">
                <% if video.thumbnail_url %>
                  <img src="<%= video.thumbnail_url %>"
                       alt="<%= video.title %>"
                       class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-200">
                <% else %>
                  <div class="w-full h-full flex items-center justify-center text-gray-400">
                    <svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"
                            d="M15 10l4.553-2.276A1 1 0 0121 8.723v6.554a1 1 0 01-1.447.894L15 14M3 8a2 2 0 012-2h10a2 2 0 012 2v8a2 2 0 01-2 2H5a2 2 0 01-2-2V8z"/>
                    </svg>
                  </div>
                <% end %>
                <% if video.duration %>
                  <span class="absolute bottom-1 right-1 bg-black/60 text-white text-xs px-1.5 py-0.5 rounded">
                    <%= format_duration(video.duration) %>
                  </span>
                <% end %>
              </div>
              <p class="mt-1.5 text-sm text-gray-800 truncate"><%= video.title %></p>
              <p class="text-xs text-gray-400"><%= video.recorded_at.strftime("%-m/%-d/%Y") %></p>
            <% end %>
          <% end %>
        </div>
      </section>
    <% end %>
  <% end %>
</div>
